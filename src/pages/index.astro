---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	ITCH_URL,
	DISCORD_URL,
	ITCH_EMBED_ID,
	OG_IMAGE_PATH,
	WHATS_NEW_URL,
	WHATS_NEW_1_2_URL,
} from '../consts';

const homeUrl = new URL('/', Astro.site).href;
const ogImageUrl = new URL(OG_IMAGE_PATH, Astro.site).href;

// SoftwareApplication structured data. Facts only, no price/offers or unshipped
// claims. Helps crawlers classify the product.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: SITE_TITLE,
	url: homeUrl,
	description: SITE_DESCRIPTION,
	applicationCategory: 'GraphicsApplication',
	operatingSystem: ['Windows', 'macOS', 'Linux', 'Android', 'iPadOS'],
	image: ogImageUrl,
	keywords:
		'procedural texture authoring, node-based textures, PBR materials, Substance 3D Designer alternative, game development, indie game development, texture tool, Rust engine, MCP server',
	featureList: [
		'Node-based procedural PBR texturing on a native Rust engine',
		'Native on Windows, macOS, Linux, Android and iPadOS',
		'Mouse, keyboard, touch, stylus and controller input',
		'A full GLSL editor for custom nodes',
		'Built-in MCP server and headless CLI',
	],
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: homeUrl },
	sameAs: [ITCH_URL, DISCORD_URL],
};

// The six pitch cards. Short. Sell it.
const why = [
	{ title: 'Native everywhere', body: 'The same application runs everywhere you want it to.' },
	{ title: 'One format', body: 'One .surfacelabs file opens on any device. Pick up right where you left off.' },
	{ title: 'Any input', body: 'Mouse, keyboard, touch, stylus, or a controller.' },
	{ title: 'Do more, faster', body: 'A native Rust engine renders most nodes in under 2 ms.' },
	{ title: 'Full GLSL editor', body: 'Out of nodes? Write your own in GLSL, compiled straight to the native engine.' },
	{ title: 'High resolution', body: 'Author up to 8192 × 8192 in full 32-bit float.*' },
];

// Per-platform packaging + backend. macOS and iPad share Metal.
const platforms = [
	{ name: 'Windows', detail: 'Portable. No installer.', backend: 'Direct3D 12' },
	{ name: 'macOS & iPad', detail: 'Signed and notarized on Mac. Native iPad app.', backend: 'Metal' },
	{ name: 'Linux', detail: 'Built for Debian and Arch.', backend: 'Vulkan' },
	{ name: 'Android', detail: 'arm64 and x64.', backend: '' },
];

const inputs = ['Mouse', 'Keyboard', 'Touch', 'Stylus', 'Controller'];

// Pipeline: the one section that gets to be technical.
const pipeline = [
	{
		name: 'Headless CLI',
		body: 'A standalone process opens a .surfacelabs file, evaluates the graph, writes the full texture set, and exits. Same engine and export path as the app, so a build step reproduces exactly what the Export dialog would write. Batch a hundred variants or drop it into CI.',
		cmd: 'surface_lab_headless project.surfacelabs --out ./textures',
	},
	{
		name: 'MCP server',
		body: 'A built-in server exposes the open project over MCP. A client can inspect the graph, add and rewire nodes, retune parameters, author a GLSL node, render any node back as an image, and export the set. Nine action-based tools, with the node registry served as JSON so the client reads the real parameter contract. Every edit is validated like the canvas, so nothing can leave a project the app will not open.',
	},
];

// Signature nodes that ship with the app. LUT authoring is future research.
const nativeNodes = [
	{ name: 'Draw', body: 'Paint masks and detail straight onto the graph.' },
	{ name: 'Custom Shader', body: 'A full GLSL editor in one node. Your code becomes ports and controls.' },
	{ name: 'Trim Sheet', body: 'Pack maps or whole materials into strips, each one tunable.' },
	{ name: 'LUT authoring', body: 'Color LUTs, authored in-graph.', tag: 'In research' },
];

// What's new in 1.2.2 highlights.
const whatsNew = [
	'A rebuilt 3D preview, with a pop-out viewer',
	'Subsurface scattering, emissive and bloom',
	'Height self-shadows and a Parallax mode',
	'Preview and export that finally agree',
	'A quality pass over two dozen nodes',
	'A manual that updates itself, offline',
];

// How It Compares. `note` renders as small print. Competitor facts verified:
// Substance MCP is third-party (not Adobe); Blender MCP is third-party; Material
// Maker has a CLI (1.5) and GLSL custom nodes.
const compareCols = ['Surface Labs', 'Substance Designer', 'Material Maker', 'Blender'];
const compareRows = [
	{
		label: 'Native on 5 platforms',
		cells: [
			{ k: 'yes', t: 'Yes', note: 'Win · Mac · Linux · Android · iPad' },
			{ k: 'no', t: 'Desktop only' },
			{ k: 'no', t: 'Desktop only' },
			{ k: 'no', t: 'Desktop only' },
		],
	},
	{
		label: 'Touch, stylus & controller',
		cells: [{ k: 'yes', t: 'Yes' }, { k: 'no', t: 'No' }, { k: 'no', t: 'No' }, { k: 'no', t: 'No' }],
	},
	{
		label: 'No account required',
		cells: [
			{ k: 'yes', t: 'Yes' },
			{ k: 'warn', t: 'Adobe ID' },
			{ k: 'yes', t: 'Yes' },
			{ k: 'yes', t: 'Yes' },
		],
	},
	{
		label: 'Author full GLSL code',
		cells: [
			{ k: 'yes', t: 'Yes' },
			{ k: 'no', t: 'Function graphs' },
			{ k: 'yes', t: 'Yes' },
			{ k: 'warn', t: 'OSL' },
		],
	},
	{
		label: 'Headless automation',
		cells: [
			{ k: 'yes', t: 'Yes', note: 'Built-in CLI' },
			{ k: 'yes', t: 'Yes', note: 'Automation Toolkit' },
			{ k: 'yes', t: 'Yes', note: 'CLI export' },
			{ k: 'yes', t: 'Yes', note: 'Python' },
		],
	},
	{
		label: 'MCP integration',
		cells: [
			{ k: 'yes', t: 'Built-in' },
			{ k: 'warn', t: 'Third-party' },
			{ k: 'no', t: 'None' },
			{ k: 'warn', t: 'Third-party' },
		],
	},
];
---

<BaseLayout title={`${SITE_TITLE}: Procedural Texture Authoring on Every Platform`} path="/">
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

	<Header current="home" />

	<main id="main">
		<!-- Hero -->
		<section class="hero">
			<div class="container hero__inner">
				<div class="hero__copy">
					<p class="eyebrow">Windows · macOS · Linux · Android · iPad</p>
					<h1 class="hero__title">Procedural textures on every platform.</h1>
					<p class="hero__lede">
						Surface Labs is a node-based PBR texturing toolkit with a native Rust
						engine at its core.
					</p>
					<div class="hero__actions">
						<a class="btn btn--secondary" href={WHATS_NEW_URL}>What's new in 1.2.2</a>
						<a class="btn btn--discord" href={DISCORD_URL} rel="noopener">
							<svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M20 4.4A19 19 0 0 0 15.2 3l-.3.5a17 17 0 0 1 4.3 1.4 15.6 15.6 0 0 0-13.8 0A17 17 0 0 1 9.7 3.5L9.4 3A19 19 0 0 0 4.6 4.4C1.6 8.8.8 13.1 1.2 17.4a19 19 0 0 0 5.8 3l.8-1.1a12 12 0 0 1-1.9-.9l.5-.4a13.6 13.6 0 0 0 11.6 0l.5.4c-.6.4-1.2.7-1.9.9l.8 1.1a19 19 0 0 0 5.8-3c.5-5-.8-9.3-3.8-13Zm-11.6 10c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2Zm7.2 0c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2Z"></path>
							</svg>
							Join the Discord
						</a>
					</div>
				</div>

				<div class="hero__figure">
					<div class="hero-cta-card">
						<p class="hero-cta-card__title">Get Surface Labs</p>
						<div class="itch-embed">
							<!-- Official itch.io store embed. -->
							<iframe
								title="Surface Labs on itch.io"
								src={`https://itch.io/embed/${ITCH_EMBED_ID}?dark=true`}
								loading="lazy"
							>
								<a href={ITCH_URL}>Surface Labs by Arctic Dev</a>
							</iframe>
						</div>
						<p class="hero-cta-card__note">
							Windows, macOS, Linux, Android and iPad. Free while in early access.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Why Surface Labs -->
		<section class="section" aria-labelledby="why-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">Why Surface Labs</p>
					<h2 id="why-heading">One toolkit, every machine you own</h2>
				</div>
				<div class="card-grid">
					{why.map((item) => (
						<article class="card">
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</article>
					))}
				</div>
				<p class="section-note">
					* 8192² authoring is desktop-only. iPadOS and Android are capped lower.
				</p>
			</div>
		</section>

		<!-- Every platform -->
		<section class="section" aria-labelledby="platforms-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">Every platform</p>
					<h2 id="platforms-heading">One build, everywhere</h2>
				</div>

				<div class="platform-rows">
					{platforms.map((p) => (
						<div class="platform-row">
							<span class="platform-row__name">{p.name}</span>
							<span class="platform-row__detail">{p.detail}</span>
							{p.backend
								? <span class="platform-row__backend">{p.backend}</span>
								: <span class="platform-row__backend platform-row__backend--none" aria-hidden="true" />}
						</div>
					))}
				</div>

				<div class="platform-foot">
					<div class="badges badges--lg">
						{inputs.map((i) => <span class="badge">{i}</span>)}
					</div>
					<p class="section-note">
						8K authoring and the MCP server run on desktop only. iPadOS and Android are memory-limited.
					</p>
				</div>
			</div>
		</section>

		<!-- Pipeline -->
		<section class="section" aria-labelledby="pipeline-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">Pipeline</p>
					<h2 id="pipeline-heading">Built to be driven</h2>
					<p>
						Surface Labs is scriptable end to end. Drive it from the command line
						for batch work and CI, or over MCP so an AI client reads and edits a
						project the same way you do.
					</p>
				</div>
				<div class="platform-cards">
					{pipeline.map((c) => (
						<article class="card card--lg">
							<h3>{c.name}</h3>
							<p>{c.body}</p>
							{c.cmd && (
								<p class="cmd">
									<code>{c.cmd}</code>
								</p>
							)}
						</article>
					))}
				</div>
				<p class="section-note section-note--center">
					The headless CLI and MCP server run on Windows, macOS and Linux.
				</p>
			</div>
		</section>

		<!-- Nodes -->
		<section class="section" aria-labelledby="nodes-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">Nodes</p>
					<h2 id="nodes-heading">A deep library, small graphs</h2>
					<p>
						Generators, filters, blends, transforms, normals, channel ops and
						math. Many are multi-mode: one Noise node covers eleven families, one
						Blend covers every mode. Fewer nodes on the canvas, graphs you can
						still read.
					</p>
				</div>
				<div class="card-grid card-grid--nodes">
					{nativeNodes.map((n) => (
						<article class="card">
							<div class="card__title-row">
								<h3>{n.name}</h3>
								{n.tag && <span class="card__tag">{n.tag}</span>}
							</div>
							<p>{n.body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- Material gallery: the one dark, full-bleed band on the page. The
		     renders are lit against near-black, so they sit on the color of the
		     app's own canvas rather than in parchment cards. -->
		<section class="section section--band" aria-labelledby="gallery-heading">
			<div class="container">
				<div class="section__head section__head--center">
					<p class="eyebrow">Gallery</p>
					<h2 id="gallery-heading">Made in Surface Labs</h2>
				</div>
				<Gallery />
			</div>
		</section>

		<!-- How it compares -->
		<section class="section" aria-labelledby="compare-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">How it compares</p>
					<h2 id="compare-heading">Where Surface Labs goes further</h2>
				</div>
				<div class="compare-wrap">
					<table class="compare">
						<thead>
							<tr>
								<th scope="col"><span class="visually-hidden">Capability</span></th>
								{compareCols.map((c, i) => (
									<th scope="col" class={i === 0 ? 'col-ours' : undefined}>{c}</th>
								))}
							</tr>
						</thead>
						<tbody>
							{compareRows.map((row) => (
								<tr>
									<th scope="row">{row.label}</th>
									{row.cells.map((cell, i) => (
										<td class={`${cell.k}${i === 0 ? ' col-ours' : ''}`}>
											<span class="visually-hidden">{cell.k === 'yes' ? 'Yes: ' : cell.k === 'no' ? 'No: ' : 'Partial: '}</span>
											{cell.t}
											{cell.note && <small>{cell.note}</small>}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- What's new -->
		<section id="whats-new" class="section" aria-labelledby="whatsnew-heading">
			<div class="container">
				<div class="section__head">
					<p class="eyebrow">What's new</p>
					<h2 id="whatsnew-heading">What's new in 1.2.2</h2>
				</div>

				<div class="whatsnew">
					<div class="whatsnew__col">
						<ul class="whatsnew__list">
							{whatsNew.map((item) => <li>{item}</li>)}
						</ul>
						<a class="whatsnew__link" href={WHATS_NEW_URL}>Read the full 1.2.2 devlog →</a>
						<a class="whatsnew__link" href={WHATS_NEW_1_2_URL}>What the 1.2 engine rewrite changed →</a>
					</div>
					<div class="whatsnew__next">
						<h3>Join the Discord</h3>
						<p>
							This is where Surface Labs gets built. Early builds land here first,
							people post what they make, and feature requests have a direct line
							to the next update. Come build with us.
						</p>
						<a class="btn btn--discord btn--block" href={DISCORD_URL} rel="noopener">
							<svg class="btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M20 4.4A19 19 0 0 0 15.2 3l-.3.5a17 17 0 0 1 4.3 1.4 15.6 15.6 0 0 0-13.8 0A17 17 0 0 1 9.7 3.5L9.4 3A19 19 0 0 0 4.6 4.4C1.6 8.8.8 13.1 1.2 17.4a19 19 0 0 0 5.8 3l.8-1.1a12 12 0 0 1-1.9-.9l.5-.4a13.6 13.6 0 0 0 11.6 0l.5.4c-.6.4-1.2.7-1.9.9l.8 1.1a19 19 0 0 0 5.8-3c.5-5-.8-9.3-3.8-13Zm-11.6 10c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2Zm7.2 0c-.9 0-1.7-.9-1.7-2s.7-2 1.7-2 1.7.9 1.7 2-.7 2-1.7 2Z"></path>
							</svg>
							Join the Discord
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Get it + contact -->
		<section class="section get" aria-labelledby="get-heading">
			<div class="container">
				<h2 id="get-heading" class="visually-hidden">Get Surface Labs and get in touch</h2>
				<div class="get__grid">
					<div class="get__download">
						<p class="get__title">Get Surface Labs</p>
						<div class="itch-embed">
							<iframe
								title="Surface Labs on itch.io"
								src={`https://itch.io/embed/${ITCH_EMBED_ID}?dark=true`}
								loading="lazy"
							>
								<a href={ITCH_URL}>Surface Labs by Arctic Dev</a>
							</iframe>
						</div>
						<p class="get__note">Windows, macOS, Linux, Android and iPad. Free while in early access.</p>
					</div>
					<Contact />
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>
