---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';

// Newest first, drafts hidden.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout
	title={`Blog | ${SITE_TITLE}`}
	description="Release notes, devlogs and behind-the-scenes updates from Surface Labs."
	path="/blog"
>
	<Header current="blog" />

	<main id="main">
		<section class="section blog-hero">
			<div class="container">
				<p class="eyebrow">Blog</p>
				<h1 class="blog-hero__title">Devlogs &amp; release notes</h1>
				<p class="blog-hero__lede">
					What's shipping, what's next, and how Surface Labs gets built.
				</p>
			</div>
		</section>

		<section class="section blog-list-section">
			<div class="container">
				{posts.length === 0 ? (
					<p class="blog-empty">No posts yet. The first one is on its way.</p>
				) : (
					<ul class="blog-list" role="list">
						{posts.map((post) => (
							<li class="blog-list__item">
								<a class="post-card" href={`/blog/${post.id}`}>
									<div class="post-card__meta">
										<time datetime={post.data.date.toISOString()}>
											{dateFmt.format(post.data.date)}
										</time>
										{post.data.tags.length > 0 && (
											<span class="post-card__tags">
												{post.data.tags.map((t) => <span class="post-card__tag">{t}</span>)}
											</span>
										)}
									</div>
									<h2 class="post-card__title">{post.data.title}</h2>
									<p class="post-card__desc">{post.data.description}</p>
									<span class="post-card__more">Read post →</span>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>
