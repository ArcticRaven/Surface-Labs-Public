---
/** Site header: brand mark, primary navigation, theme toggle and store CTA. */
import { Image } from 'astro:assets';
import { SITE_TITLE, ITCH_URL, REPO_URL, DISCORD_URL } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import appIcon from '../assets/app-icon.png';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<Image class="brand__mark" src={appIcon} alt="" width={28} height={28} loading="eager" />
			<span>{SITE_TITLE}</span>
		</a>

		<nav class="site-nav" aria-label="Primary">
			<a class="site-nav__link" href={DISCORD_URL} rel="noopener">Discord</a>
			<a
				class="site-nav__link site-nav__link--hide-tablet"
				href={REPO_URL}
				rel="noopener"
			>GitHub</a>
			<ThemeToggle />
			<a class="btn btn--primary site-nav__cta" href={ITCH_URL} rel="noopener">
				Get on itch.io
			</a>
		</nav>
	</div>
</header>
