---
/**
 * Material gallery carousel.
 *
 * Shows square renders of materials authored in Surface Labs — no UI
 * screenshots (those belong to the docs, in src/assets/docs/). Auto-loads
 * every image in src/assets/screenshots/ (sorted by filename, so a numeric
 * prefix controls order) and renders an accessible, scroll-snap carousel. To
 * add a material, drop a square render in that folder — optionally add a
 * caption/alt entry below keyed by the filename (without extension).
 *
 * Interactivity is a small amount of vanilla JS (no framework): the track is a
 * native horizontal scroll container, so touch swipe and trackpad already work;
 * the buttons and dots just drive scrollTo.
 */
import { Image } from 'astro:assets';

const modules = import.meta.glob('../assets/screenshots/*.{png,jpg,jpeg,webp}', {
	eager: true,
});

/** Optional captions/alt text keyed by filename without extension. */
const META: Record<string, { caption: string; alt: string }> = {
	'03-material': {
		caption: 'Tiled ceramic',
		alt: 'A tiled ceramic PBR material authored in Surface Labs, rendered on a rounded cube.',
	},
	'06-galaxy-material': {
		caption: 'Deep Space Nebula',
		alt: 'A deep space nebula material authored in Surface Labs, rendered on a sphere: wisps of blue gas and pinpoint stars against near-black space.',
	},
};

function humanize(base: string): string {
	const s = base.replace(/^\d+[-_]?/, '').replace(/[-_]+/g, ' ').trim();
	return s ? s.charAt(0).toUpperCase() + s.slice(1) : base;
}

type Slide = { src: ImageMetadata; caption: string; alt: string };

const slides: Slide[] = Object.entries(modules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod]) => {
		const base = (path.split('/').pop() ?? path).replace(/\.[^.]+$/, '');
		const meta = META[base];
		const caption = meta?.caption ?? humanize(base);
		return {
			src: (mod as { default: ImageMetadata }).default,
			caption,
			alt: meta?.alt ?? `A material authored in Surface Labs: ${caption}.`,
		};
	});

const count = slides.length;
---

{
	count > 0 && (
		<div
			class="carousel"
			aria-roledescription="carousel"
			aria-label="Materials authored in Surface Labs"
		>
			<button
				type="button"
				class="carousel__nav carousel__nav--prev"
				aria-label="Previous material"
			>
				<span aria-hidden="true">&#8249;</span>
			</button>

			<ul class="carousel__track" role="list" tabindex="0">
				{slides.map((slide, i) => (
					<li
						class="carousel__slide"
						role="group"
						aria-roledescription="slide"
						aria-label={`${i + 1} of ${count}: ${slide.caption}`}
					>
						<figure class="carousel__figure">
							<Image
								src={slide.src}
								alt=""
								widths={[600, 900, 1280]}
								sizes="(max-width: 700px) 94vw, 560px"
								loading="lazy"
							/>
							{/* The image stands on its own; the description fades in
							    over it on hover or keyboard focus. The figcaption stays
							    in the accessibility tree throughout (opacity, not
							    display), so the empty img alt is not a loss. */}
							<figcaption class="carousel__overlay">
								<strong>{slide.caption}</strong>
								{slide.alt}
							</figcaption>
						</figure>
					</li>
				))}
			</ul>

			<button
				type="button"
				class="carousel__nav carousel__nav--next"
				aria-label="Next material"
			>
				<span aria-hidden="true">&#8250;</span>
			</button>

			<div class="carousel__dots" role="tablist" aria-label="Choose material">
				{slides.map((slide, i) => (
					<button
						type="button"
						class="carousel__dot"
						role="tab"
						aria-label={`Show material ${i + 1}: ${slide.caption}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						data-index={i}
					/>
				))}
			</div>
		</div>
	)
}

<script>
	// Vanilla, framework-free carousel behaviour.
	for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
		const track = carousel.querySelector<HTMLElement>('.carousel__track');
		const prev = carousel.querySelector<HTMLButtonElement>('.carousel__nav--prev');
		const next = carousel.querySelector<HTMLButtonElement>('.carousel__nav--next');
		const dots = Array.from(
			carousel.querySelectorAll<HTMLButtonElement>('.carousel__dot')
		);
		if (!track) continue;

		const slides = Array.from(
			track.querySelectorAll<HTMLElement>('.carousel__slide')
		);
		const count = slides.length;

		// One scroll step is the distance between slide starts (width + gap),
		// measured from the DOM so the CSS gap stays the single source of truth.
		const step = () =>
			count > 1
				? slides[1].offsetLeft - slides[0].offsetLeft
				: track.clientWidth;

		const indexFromScroll = () => Math.round(track.scrollLeft / step());

		const goTo = (i: number) => {
			const clamped = Math.max(0, Math.min(count - 1, i));
			track.scrollTo({ left: clamped * step(), behavior: 'smooth' });
		};

		const sync = () => {
			const i = indexFromScroll();
			dots.forEach((d, di) =>
				d.setAttribute('aria-selected', di === i ? 'true' : 'false')
			);
			if (prev) prev.disabled = i <= 0;
			if (next) next.disabled = i >= count - 1;
		};

		prev?.addEventListener('click', () => goTo(indexFromScroll() - 1));
		next?.addEventListener('click', () => goTo(indexFromScroll() + 1));
		dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

		let raf = 0;
		track.addEventListener('scroll', () => {
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(sync);
		});
		window.addEventListener('resize', sync);
		sync();
	}
</script>
