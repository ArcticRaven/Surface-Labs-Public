---
/**
 * Light/dark theme toggle for the standalone marketing pages.
 *
 * It reads and writes the same `starlight-theme` localStorage key Starlight
 * uses, so the choice carries over between the homepage and the docs. The
 * no-flash resolution happens in BaseLayout's inline head script; this button
 * just flips the current value.
 */
---

<button
	type="button"
	class="theme-toggle"
	aria-label="Toggle light and dark theme"
>
	{/* Shown in light mode (click to go dark). */}
	<svg class="icon-light" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path
			d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
			fill="currentColor"
		></path>
	</svg>
	{/* Shown in dark mode (click to go light). */}
	<svg
		class="icon-dark"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	</svg>
</button>

<script>
	const KEY = 'starlight-theme';
	for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
		const setPressed = () =>
			btn.setAttribute(
				'aria-pressed',
				String(document.documentElement.dataset.theme === 'dark')
			);
		setPressed();
		btn.addEventListener('click', () => {
			const current =
				document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem(KEY, next);
			} catch {}
			setPressed();
		});
	}
</script>
